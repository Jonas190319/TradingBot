{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentSignal",
  "type": "object",
  "required": ["ts", "symbol", "agent_type", "direction", "confidence", "risk_score", "recommendation", "rationale"],
  "properties": {
    "ts": {"type": "string", "format": "date-time"},
    "symbol": {"type": "string"},
    "agent_type": {"enum": ["news", "macro", "technical", "quant", "regime", "portfolio", "risk", "execution", "improvement"]},
    "direction": {"enum": ["long", "short", "neutral", "no_trade"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 100},
    "risk_score": {"type": "number", "minimum": 0, "maximum": 100},
    "recommendation": {"type": "string"},
    "rationale": {"type": "string"},
    "payload": {"type": "object"}
  }
}
